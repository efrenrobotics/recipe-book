---
import "../styles/global.css";
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/500.css";
import "@fontsource/dm-sans/600.css";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
const {
  title = "A personal cookbook",
  description = "Recipes, experiments, and things worth making again. A personal cookbook by Efren Mendoza.",
} = Astro.props;
const path = Astro.url.pathname;
const nav = [
  ["Recipes", "/recipes/"],
  ["Collections", "/collections/"],
  ["Menus", "/menus/"],
  ["Coffee", "/coffee/"],
  ["About", "/about/"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f4ef" />
    <title>{title} — Efren’s Kitchen</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Efren’s Kitchen home">
        EFREN’S KITCHEN
      </a>
      <nav aria-label="Main navigation">
        {nav.map(([label, href]) => (
          <a
            href={href}
            aria-current={path.startsWith(href) ? "page" : undefined}
          >
            {label}
          </a>
        ))}
      </nav>
      <a
        class="search-link"
        href="/recipes/?search=1"
        aria-label="Search recipes (press slash)"
      >
        <svg
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <circle cx="10.5" cy="10.5" r="6.5" />
          <path d="m15.5 15.5 5 5" />
        </svg>
        <span class="shortcut">/</span>
      </a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <a href="/" class="footer-brand">
          Good food.
          <br />
          <i>Worth keeping.</i>
        </a>
        <p>
          A personal cookbook by Efren Mendoza.
          <br />
          Austin, Texas.
        </p>
      </div>
      <div class="footer-links">
        <a href="/recipes/">The recipe index ↗</a>
        <a href="/shopping/">Your shopping list ↗</a>
        <a href="/about/">A note about this kitchen ↗</a>
      </div>
      <div class="footer-bottom">
        <span>COOK. CHANGE. MAKE AGAIN.</span>
        <span>
          EST. 2026 <span class="blue">●</span>
        </span>
        <a
          href="#top"
          onclick="window.scrollTo({top:0,behavior:'smooth'});return false;"
        >
          BACK TO TOP ↑
        </a>
      </div>
    </footer>
    <script>
      document.addEventListener("keydown", (e) => {
        if (
          e.key === "/" &&
          !["INPUT", "TEXTAREA"].includes((e.target as HTMLElement).tagName) &&
          !(e.target as HTMLElement).isContentEditable
        ) {
          e.preventDefault();
          location.href = "/recipes/?search=1";
        }
      });
    </script>
  </body>
</html>
