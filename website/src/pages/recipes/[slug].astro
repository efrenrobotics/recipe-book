---
import Layout from "../../layouts/Layout.astro";
import CookingTools from "../../components/CookingTools";
import { recipes } from "../../lib/recipes";
export function getStaticPaths() {
  return recipes.map((recipe) => ({
    params: { slug: recipe.slug },
    props: { recipe },
  }));
}
const { recipe: r } = Astro.props;
---

<Layout title={r.title} description={r.description}>
  <article class="page-pad recipe-page">
    <div class="recipe-breadcrumb eyebrow">
      <a href="/recipes/">← THE RECIPE INDEX</a>
      <span>
        {r.draft
          ? "KITCHEN DRAFT"
          : r.complete
            ? "FROM THE RECIPE BOOK"
            : "SAVED INSPIRATION"}
      </span>
    </div>
    <div class="recipe-heading">
      <span class="recipe-big-number">{r.number}</span>
      <div>
        <h1>{r.title}</h1>
        <p class="recipe-description">{r.description}</p>
      </div>
    </div>
    {r.complete && (
      <div class="recipe-metadata">
        {[
          [
            "Time",
            r.timeKnown ? `${r.prepTime + r.cookTime} min` : "Not recorded",
          ],
          ["Serves", r.servings],
          ["Difficulty", r.difficulty],
          ["Method", r.method],
        ].map(([label, value]) => (
          <div>
            <span>{label}</span>
            <strong>{value}</strong>
          </div>
        ))}
      </div>
    )}
    {r.dietaryTags.length > 0 && (
      <div class="dietary-labels">
        {r.dietaryTags.map((t) => (
          <span>{t.replaceAll("-", " ")}</span>
        ))}
      </div>
    )}
    {r.image && (
      <figure class="recipe-hero">
        <img
          src={r.image}
          alt={r.title}
          width="1536"
          height="1024"
          fetchpriority="high"
        />
        <figcaption>
          AN ILLUSTRATIVE KITCHEN PHOTOGRAPH · AI-GENERATED
        </figcaption>
      </figure>
    )}
    {r.complete ? (
      <>
        <CookingTools client:load recipe={r} />
        <noscript>
          <h2>Ingredients · {r.servings} servings</h2>
          <ul>
            {r.ingredients.map((i) => (
              <li>{i}</li>
            ))}
          </ul>
          <h2>Method</h2>
          <ol>
            {r.steps.map((s) => (
              <li>{s}</li>
            ))}
          </ol>
        </noscript>
      </>
    ) : (
      <section class="source-note">
        <span class="eyebrow blue">A BOOKMARK FOR LATER</span>
        <h2>This one is still in the notebook.</h2>
        <p>
          The saved post doesn’t include a complete, verified recipe.
          Ingredients, timing, and dietary details still need to be checked at
          the source.
        </p>
        {r.sourceUrl && (
          <a
            class="text-link"
            href={r.sourceUrl}
            target="_blank"
            rel="noreferrer"
          >
            Open the original recipe ↗
          </a>
        )}
        <h3>What was saved</h3>
        <ul>
          {r.ingredients.map((i) => (
            <li>{i}</li>
          ))}
        </ul>
        {r.containsEggs && (
          <p>
            This source may contain eggs. An egg-free adaptation is required
            before cooking.
          </p>
        )}
      </section>
    )}
    <aside class="recipe-notes">
      <span class="eyebrow blue">IN THE MARGINS</span>
      <div>
        <h2>
          Efren’s notes<span class="blue">↙</span>
        </h2>
        {r.notes.map((note) => (
          <p>{note}</p>
        ))}
      </div>
    </aside>
    <div class="recipe-provenance eyebrow">
      <span>
        {r.source === "chef"
          ? "PROPOSED RECIPE / NOT YET TESTED"
          : `COLLECTED FROM ${r.creator || r.source}`}
      </span>
      {r.sourceUrl && (
        <a href={r.sourceUrl} target="_blank" rel="noreferrer">
          SOURCE / INSPIRATION ↗
        </a>
      )}
      {r.timesMade !== undefined && <span>MADE {r.timesMade}×</span>}
      {r.firstMade && <span>FIRST MADE {r.firstMade}</span>}
      {r.lastMade && <span>LAST MADE {r.lastMade}</span>}
      {r.rating && <span>RATING {r.rating}/5</span>}
    </div>
  </article>
</Layout>
