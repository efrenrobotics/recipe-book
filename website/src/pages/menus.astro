---
import Layout from "../layouts/Layout.astro";
import MenuPlanner from "../components/MenuPlanner";
import { recipes } from "../lib/recipes";
---

<Layout title="Menus for a full table">
  <section class="page-pad menu-page">
    <div class="eyebrow blue">FOOD IS BETTER WITH COMPANY</div>
    <div class="page-title">
      <h1>
        Menus<span class="blue">.</span>
      </h1>
      <p>
        Less juggling.
        <br />
        More time at the table.
      </p>
    </div>
    <MenuPlanner client:load recipes={recipes.filter((r) => r.complete)} />
  </section>
</Layout>
