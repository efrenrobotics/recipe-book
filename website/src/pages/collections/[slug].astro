---
import Layout from "../../layouts/Layout.astro";
import RecipeCard from "../../components/RecipeCard.astro";
import { chapters, recipes } from "../../lib/recipes";
export function getStaticPaths() {
  return chapters.map((chapter) => ({
    params: { slug: chapter.slug },
    props: { chapter },
  }));
}
const { chapter } = Astro.props;
const entries = recipes.filter((r) => r.collections.includes(chapter.slug));
---

<Layout title={chapter.title}>
  <section class="page-pad collection-detail">
    <a href="/collections/" class="eyebrow">
      ← ALL COLLECTIONS
    </a>
    <div class="collection-heading">
      <span class="eyebrow blue">CHAPTER {chapter.number}</span>
      <h1>
        {chapter.title}
        <span class="blue">.</span>
      </h1>
      <p>{chapter.description}</p>
    </div>
    <div class="collection-recipes">
      {entries.map((recipe) => (
        <RecipeCard recipe={recipe} />
      ))}
    </div>
  </section>
</Layout>
